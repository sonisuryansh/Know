{
  "name": "know",
  "displayName": "Know",
  "description": "A free developer workspace for tasks, focus sessions, projects, and coding activity inside VS Code.",
  "version": "1.0.0",
  "publisher": "sonisuryansh",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sonisuryansh/Know.git"
  },
  "bugs": {
    "url": "https://github.com/sonisuryansh/Know/issues"
  },
  "homepage": "https://github.com/sonisuryansh/Know#readme",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "developer",
    "productivity",
    "focus",
    "tasks",
    "project-management",
    "coding",
    "developer-tools"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dev-focus-explorer",
          "title": "Know",
          "icon": "media/icons/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "dev-focus-explorer": [
        {
          "type": "webview",
          "id": "devFocus.sidebarView",
          "name": "Know"
        }
      ]
    },
    "commands": [
      {
        "command": "devFocus.startSession",
        "title": "Know: Start Focus Session",
        "category": "Know"
      },
      {
        "command": "devFocus.quickAddTask",
        "title": "Know: Quick Add Task to Inbox",
        "category": "Know"
      },
      {
        "command": "devFocus.createTaskFromCurrentFile",
        "title": "Know: Create Task from Current File",
        "category": "Know"
      },
      {
        "command": "devFocus.startFocusOnFile",
        "title": "Know: Start Focus on This File",
        "category": "Know"
      },
      {
        "command": "devFocus.importGitHubRepo",
        "title": "Know: Import GitHub Repository",
        "category": "Know"
      },
      {
        "command": "devFocus.associateCurrentWorkspace",
        "title": "Know: Associate Current Workspace as Project",
        "category": "Know"
      },
      {
        "command": "devFocus.pauseSession",
        "title": "Know: Pause Focus Session",
        "category": "Know"
      },
      {
        "command": "devFocus.resumeSession",
        "title": "Know: Resume Focus Session",
        "category": "Know"
      },
      {
        "command": "devFocus.finishSession",
        "title": "Know: Finish Focus Session",
        "category": "Know"
      },
      {
        "command": "devFocus.createTask",
        "title": "Know: Create New Task",
        "category": "Know"
      },
      {
        "command": "devFocus.linkCurrentFile",
        "title": "Know: Link Current File to Task",
        "category": "Know"
      },
      {
        "command": "devFocus.viewFocus",
        "title": "Know: View Focus Hub",
        "category": "Know"
      },
      {
        "command": "devFocus.viewStats",
        "title": "Know: View Productivity Stats & Heatmap",
        "category": "Know"
      },
      {
        "command": "devFocus.openInTab",
        "title": "Know: Open Focus Hub in Editor Tab",
        "category": "Know"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "devFocus.startFocusOnFile",
          "group": "7_modification@1"
        },
        {
          "command": "devFocus.createTaskFromCurrentFile",
          "group": "7_modification@2"
        }
      ],
      "explorer/context": [
        {
          "command": "devFocus.startFocusOnFile",
          "group": "7_modification@1"
        },
        {
          "command": "devFocus.createTaskFromCurrentFile",
          "group": "7_modification@2"
        }
      ]
    },
    "configuration": {
      "title": "Know",
      "properties": {
        "know.defaultDurationMinutes": {
          "type": "number",
          "default": 35,
          "description": "Default target focus time in minutes for focus sessions."
        },
        "devFocus.defaultDurationMinutes": {
          "type": "number",
          "default": 35,
          "markdownDescription": "Legacy setting: Default target focus time in minutes for focus sessions."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-git-tag-version",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  }
}
